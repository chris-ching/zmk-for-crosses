// Miryoku QWERTY FLIP for Crosses 3x6 with right-hand trackball
//
// FLIP means only thumb assignments are swapped vs standard Miryoku:
//   Standard: left thumb → NAV/MOUSE/MEDIA, right thumb → NUM/SYM/FUN
//   FLIP:     RIGHT thumb → NAV/MOUSE/MEDIA, LEFT thumb → NUM/SYM/FUN
// Alpha layout is standard QWERTY (unchanged).
// Layer content sides match standard Miryoku (NAV on right, NUM on left, etc.)
//
// Layer map:
//   0 BASE  – standard QWERTY, GACS home-row mods
//   1 NAV   – RIGHT-hand IJKL arrows/page-nav  (scroll-layers=<1> → trackball scrolls)
//   2 MOUSE – LEFT-hand click buttons           (trackball moves cursor; snipe on this layer)
//   3 MEDIA – RIGHT-hand media controls
//   4 NUM   – LEFT-hand numpad
//   5 SYM   – LEFT-hand symbols
//   6 FUN   – RIGHT-hand F-keys + LEFT-hand BT controls
//
// Thumb assignments (outer → inner):
//   Left:  TAB(MOUSE)  BSPC(NUM)  RET(SYM)
//   Right: ESC(MEDIA)  SPC(NAV)   DEL(FUN)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define MOUSE 2
#define MEDIA 3
#define NUM   4
#define SYM   5
#define FUN   6

// Layer-tap for thumb keys
&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        // Home-row mods: slower timing + require prior idle to avoid accidental triggers
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ── BASE ──────────────────────────────────────────────────────────
        // Standard QWERTY with GACS home-row mods
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐  ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │      │  Q   │  W   │  E   │  R   │  T   │  │  Y   │  U   │  I   │  O   │  P   │      │
        // │      │ A/G  │ S/A  │ D/C  │ F/S  │  G   │  │  H   │ J/S  │ K/C  │ L/A  │ '/G  │      │
        // │      │  Z   │  X   │  C   │  V   │  B   │  │  N   │  M   │  ,   │  .   │  /   │      │
        // └──────┴──────┴──────┼──────┼──────┼──────┤  ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │TAB/Mo│BSP/N │RET/S │  │ESC/M │SPC/N │DEL/F │
        //                      └──────┴──────┴──────┘  └──────┴──────┴──────┘
        base_layer {
            label = "BASE";
            bindings = <
&none  &kp Q          &kp W         &kp E          &kp R          &kp T    &kp Y  &kp U          &kp I          &kp O          &kp P           &none
&none  &hm LGUI A     &hm LALT S    &hm LCTRL D    &hm LSFT F     &kp G    &kp H  &hm RSFT J     &hm RCTRL K    &hm RALT L     &hm RGUI APOS   &none
&none  &kp Z          &kp X         &kp C          &kp V          &kp B    &kp N  &kp M          &kp COMMA      &kp DOT        &kp SLASH       &none
                      &lt MOUSE TAB  &lt NUM BSPC  &lt SYM RET           &lt MEDIA ESC  &lt NAV SPC  &lt FUN DEL
            >;
        };

        // ── NAV ── (layer 1 → trackball scrolls!) ─────────────────────────
        // IJKL arrow cluster on RIGHT hand. Right thumb SPC (mid) activates.
        // I = Up, J = Left, K = Down, L = Right.
        // PgUp/PgDn flank Up on the top row; Home/End flank the arrow row.
        // Clipboard + extras on bottom row.
        //
        // ┌──────┬──────┬──────┬──────┬──────┐  ┌──────┬──────┬──────┬──────┬──────┐
        // │      │      │      │      │      │  │ UNDO │ PGUP │  ↑   │ PGDN │ REDO │
        // │      │      │      │      │      │  │ HOME │  ←   │  ↓   │  →   │  END │
        // │      │      │      │      │      │  │ CUT  │ COPY │PASTE │  INS │ CAPS │
        //                [TAB]  BSP   RET        [held] [held]  DEL
        nav_layer {
            label = "NAV";
            bindings = <
&trans  &trans   &trans    &trans    &trans    &trans    &kp K_UNDO  &kp PG_UP   &kp UP      &kp PG_DN    &kp K_REDO  &trans
&trans  &trans   &trans    &trans    &trans    &trans    &kp HOME    &kp LEFT    &kp DOWN    &kp RIGHT    &kp END     &trans
&trans  &trans   &trans    &trans    &trans    &trans    &kp K_CUT   &kp K_COPY  &kp K_PASTE &kp INS      &kp CAPS    &trans
                 &trans    &kp BSPC  &kp RET             &trans      &trans      &kp DEL
            >;
        };

        // ── MOUSE ─────────────────────────────────────────────────────────
        // Trackball handles all movement; left hand S/D/F = RCLK/MCLK/LCLK.
        // Left thumb TAB (outer) activates. Right hand fully transparent.
        // snipe-layers=<2> → precision CPI on this layer.
        //
        // ┌──────┬──────┬──────┬──────┬──────┐  ┌──────┬──────┬──────┬──────┬──────┐
        // │      │      │      │      │      │  │      │      │      │      │      │
        // │      │RCLK  │MCLK  │LCLK  │      │  │      │      │      │      │      │
        // │      │      │      │      │      │  │      │      │      │      │      │
        //         [held] MCLK  LCLK              [trans][trans][trans]
        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mkp RCLK   &mkp MCLK   &mkp LCLK   &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans      &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans
                    &trans      &mkp MCLK   &mkp LCLK             &trans  &trans  &trans
            >;
        };

        // ── MEDIA ─────────────────────────────────────────────────────────
        // Standard Miryoku MEDIA on RIGHT hand.
        // Right thumb ESC (inner) activates.
        media_layer {
            label = "MEDIA";
            bindings = <
&trans  &trans       &trans      &trans       &trans       &trans    &trans      &trans       &trans        &trans        &trans      &trans
&trans  &trans       &trans      &trans       &trans       &trans    &kp C_MUTE  &kp C_PREV   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &trans
&trans  &trans       &trans      &trans       &trans       &trans    &trans      &trans       &trans        &trans        &trans      &trans
                     &kp C_STOP  &kp C_PP     &kp C_MUTE            &trans      &kp C_PP     &kp C_MUTE
            >;
        };

        // ── NUM ───────────────────────────────────────────────────────────
        // Standard Miryoku NUM on LEFT hand (QWERT/ASDFG/ZXCVB positions).
        //   Row0: [  7  8  9  ]
        //   Row1: ;  4  5  6  =
        //   Row2: `  1  2  3  \
        // Left thumb BSPC (mid) activates.
        // Left outer tap = DOT, left inner tap = MINUS, right mid tap = N0.
        num_layer {
            label = "NUM";
            bindings = <
&trans  &kp LBKT   &kp N7   &kp N8   &kp N9   &kp RBKT    &trans  &trans   &trans  &trans  &trans  &trans
&trans  &kp SEMI   &kp N4   &kp N5   &kp N6   &kp EQUAL   &trans  &trans   &trans  &trans  &trans  &trans
&trans  &kp GRAVE  &kp N1   &kp N2   &kp N3   &kp BSLH    &trans  &trans   &trans  &trans  &trans  &trans
                   &kp DOT  &trans   &kp MINUS             &trans  &kp N0   &trans
            >;
        };

        // ── SYM ───────────────────────────────────────────────────────────
        // Standard Miryoku SYM on LEFT hand (shifted numpad equivalents).
        //   Row0: {  &  *  (  }
        //   Row1: :  $  %  ^  +
        //   Row2: ~  !  @  #  |
        // Left thumb RET (inner) activates.
        // Left outer tap = LPAR, left mid tap = RPAR, right inner tap = UNDER.
        sym_layer {
            label = "SYM";
            bindings = <
&trans  &kp LBRC   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RBRC    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &kp COLON  &kp DLLR   &kp PRCNT  &kp CARET  &kp PLUS    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp PIPE    &trans      &trans  &trans  &trans  &trans  &trans
                   &kp LPAR   &kp RPAR   &trans                  &kp UNDER   &trans  &trans
            >;
        };

        // ── FUN ───────────────────────────────────────────────────────────
        // F-keys on RIGHT hand (YUIOP/HJKL/NM,./ positions).
        // BT controls on LEFT hand top row (QWERT positions).
        // Right thumb DEL (outer) activates.
        //   Right Row0: F12  F7  F8  F9  PSCR
        //   Right Row1: F11  F4  F5  F6  SCRL
        //   Right Row2: F10  F1  F2  F3  PAUS
        //   Left  Row0: BT0  BT1  BT2  BT3  BTCLR
        // Left outer tap = TAB, left mid tap = SPC, right outer = [activator].
        fun_layer {
            label = "FUN";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &kp F12  &kp F7   &kp F8   &kp F9   &kp PSCRN        &trans
&trans  &trans        &trans        &trans        &trans        &trans         &kp F11  &kp F4   &kp F5   &kp F6   &kp SLCK         &trans
&trans  &trans        &trans        &trans        &trans        &trans         &kp F10  &kp F1   &kp F2   &kp F3   &kp PAUSE_BREAK  &trans
                      &trans        &kp SPC       &trans                      &trans   &trans   &trans
            >;
        };

    };
};
